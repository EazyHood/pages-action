{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "SAXON_RELEASE = (?<currentValue>SaxonHE[0-9]+-[0-9]+)"
      ],
      "depNameTemplate": "Saxonica/Saxon-HE",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^SaxonHE(?<major>\\d+)-(?<minor>\\d+)$"
    }
  ]
}
